rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function userRole() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : "guest";
    }

    function isAdmin() {
      return userRole() in ["admin", "teacher"];
    }

    function isStrictAdmin() {
      return userRole() == "admin";
    }

    match /users/{userId} {
      allow create: if isOwner(userId)
        && request.resource.data.role in ["tester"];
      allow read: if isOwner(userId) || isAdmin();
      allow update: if isAdmin()
        || (
          isOwner(userId)
          && request.resource.data.role == resource.data.role
        );
      allow delete: if isAdmin();

      match /clients/{clientId} {
        allow create: if isOwner(userId) || isAdmin();
        allow read: if isOwner(userId) || isAdmin();
        allow update: if isOwner(userId) || isAdmin();
        allow delete: if isOwner(userId) || isAdmin();

        // 同一帳號可在手機與電腦間接續 Gemini 問答。
        match /geminiChats/{chatId} {
          allow read, write: if isOwner(userId) || isAdmin();
        }
      }
    }

    match /consultationRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.userUid == request.auth.uid
        && request.resource.data.question is string
        && request.resource.data.topic is string;
      allow read, update, delete: if isStrictAdmin();
    }
  }
}
